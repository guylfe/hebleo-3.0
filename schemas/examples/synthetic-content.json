  "exercises": [
    {
      "id": "ex-1-recognize",
      "lessonId": "lesson-1",
      "type": "recognition",
      "wordId": "w-mi",
      "prompt": "Choose the meaning of this word.",
      "distractors": [
        "I",
        "he",
        "she"
      ],
      "concept": "Pronouns and question words",
      "feedback": "מִי asks “who”. The pronouns refer to the speaker or another person."
    },
    {
      "id": "ex-1-type",
      "lessonId": "lesson-1",
      "type": "typing",
      "wordId": "w-ani",
      "prompt": "Type the Hebrew word for “I”.",
      "concept": "Pronouns",
      "feedback": "אֲנִי means “I”."
    },
    {
      "id": "ex-1-match",
      "lessonId": "lesson-1",
      "type": "matching",
      "wordIds": [
        "w-hu",
        "w-hi",
        "w-mi"
      ],
      "prompt": "Match each word to its meaning.",
      "concept": "Pronouns and question words",
      "feedback": "הוּא means “he”, הִיא means “she”, and מִי means “who”."
    },
    {
      "id": "ex-2-order",
      "lessonId": "lesson-2",
      "type": "ordering",
      "prompt": "Build: “I am at home.”",
      "tokens": [
        "ב",
        "בית",
        "אני"
      ],
      "answers": [
        "אני בבית"
      ],
      "concept": "Location sentences",
      "feedback": "אני בבית means “I am at home”. These present-tense examples have no separate word for “am”.",
      "prefixTokenIndices": [
        0
      ]
    },
    {
      "id": "ex-2-cloze",
      "lessonId": "lesson-2",
      "type": "cloze",
      "prompt": "Type the missing word: ___ בבית — She is at home.",
      "answers": [
        "היא"
      ],
      "nikkudOverride": "none",
      "concept": "Pronouns in context",
      "feedback": "היא is the feminine singular pronoun “she”. Enter the missing pronoun, rather than the full sentence."
    },
    {
      "id": "ex-2-transform",
      "lessonId": "lesson-2",
      "type": "transformation",
      "prompt": "Change “He is at home” to “She is at home”.",
      "context": "הוא בבית",
      "answers": [
        "היא בבית"
      ],
      "concept": "Pronouns in context",
      "feedback": "Replace הוא with היא. The location expression בבית stays the same."
    },
    {
      "id": "ex-3-recognize",
      "lessonId": "lesson-3",
      "type": "recognition",
      "wordId": "w-kotevet",
      "prompt": "Choose the meaning of this form.",
      "distractors": [
        "he",
        "at home",
        "writes (masculine singular)"
      ],
      "concept": "Feminine verb forms",
      "feedback": "כותבת is the feminine singular present form."
    },
    {
      "id": "ex-3-transform",
      "lessonId": "lesson-3",
      "type": "transformation",
      "prompt": "Change the subject and verb to feminine.",
      "context": "הוא כותב",
      "answers": [
        "היא כותבת"
      ],
      "concept": "Subject and verb agreement",
      "feedback": "Use היא with כותבת so both subject and verb are feminine singular."
    },
    {
      "id": "ex-3-order",
      "lessonId": "lesson-3",
      "type": "ordering",
      "prompt": "Build: “She is writing here.”",
      "tokens": [
        "פה",
        "כותבת",
        "היא"
      ],
      "answers": [
        "היא כותבת פה"
      ],
      "concept": "Subject and verb agreement",
      "feedback": "היא כותבת פה means “She is writing here”. The subject and verb agree."
    }
