{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hebleo.invalid/contracts/vocabulary-import.v1.schema.json",
  "title": "Frozen author vocabulary import record",
  "type": "object",
  "required": [
    "version",
    "headers",
    "values",
    "columns"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "headers": {
      "type": "array",
      "minItems": 5,
      "maxItems": 2000,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "\\S",
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      }
    },
    "values": {
      "type": "array",
      "minItems": 5,
      "maxItems": 2000,
      "items": {
        "type": "string",
        "maxLength": 12000
      }
    },
    "columns": {
      "type": "array",
      "minItems": 5,
      "maxItems": 2000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/column"
      }
    }
  },
  "additionalProperties": true,
  "definitions": {
    "column": {
      "type": "object",
      "required": [
        "columnIndex",
        "target",
        "decode"
      ],
      "properties": {
        "columnIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1999
        },
        "target": {
          "enum": [
            "id",
            "pointed",
            "unpointed",
            "curated",
            "english",
            "notes",
            "root",
            "pattern",
            "gender",
            "plural",
            "feminine",
            "pluralFeminine",
            "infinitive",
            "partOfSpeech",
            "audio",
            "introducedLesson",
            "part",
            "tags",
            "fieldFormatting",
            "sourceTheme",
            "color",
            "bold",
            "noVocab",
            "noCard",
            "fieldStyle"
          ]
        },
        "decode": {
          "enum": [
            "string",
            "json",
            "boolean"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "target": {
                "const": "fieldStyle"
              }
            }
          },
          "then": {
            "required": [
              "field",
              "property"
            ],
            "properties": {
              "field": {
                "enum": [
                  "pointed",
                  "unpointed",
                  "curated",
                  "english",
                  "notes",
                  "root",
                  "pattern",
                  "gender",
                  "plural",
                  "feminine",
                  "pluralFeminine",
                  "infinitive",
                  "partOfSpeech",
                  "audio",
                  "introducedLesson",
                  "part"
                ]
              },
              "property": {
                "enum": [
                  "bold",
                  "italic",
                  "foregroundColor",
                  "backgroundColor",
                  "horizontalAlignment",
                  "textDirection"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "property": {
                      "enum": [
                        "bold",
                        "italic"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "decode": {
                      "const": "boolean"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "decode": {
                      "const": "string"
                    }
                  }
                }
              }
            ]
          },
          "else": {
            "allOf": [
              {
                "if": {
                  "properties": {
                    "target": {
                      "enum": [
                        "tags",
                        "fieldFormatting",
                        "sourceTheme"
                      ]
                    }
                  }
                },
                "then": {
                  "properties": {
                    "decode": {
                      "const": "json"
                    }
                  }
                },
                "else": {
                  "if": {
                    "properties": {
                      "target": {
                        "enum": [
                          "bold",
                          "noVocab",
                          "noCard"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "decode": {
                        "const": "boolean"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "decode": {
                        "const": "string"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
