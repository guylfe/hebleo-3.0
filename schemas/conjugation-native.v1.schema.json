{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hebleo.invalid/contracts/conjugation-native.v1.schema.json",
  "title": "Exact native lesson unlocks and historical learned form IDs; approval is enforced by Store",
  "definitions": {
    "formId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_:-]*$",
      "not": {
        "enum": [
          "constructor",
          "prototype",
          "__proto__"
        ]
      }
    },
    "learnedFormIds": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/formId"
      },
      "uniqueItems": true,
      "maxItems": 10000
    },
    "lessonUnlocks": {
      "type": "object",
      "properties": {
        "formIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/formId"
          },
          "uniqueItems": true,
          "maxItems": 10000
        }
      },
      "required": [
        "formIds"
      ],
      "additionalProperties": false
    }
  }
}
