{
  "name": "hebleo-3-local-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js --demo-fresh-progress",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --check src/store.js && node --check public/app.js && node --check public/learner-view.js && node --check public/preview/learner-renderer.js",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "easymde": "2.21.0",
    "marked": "18.0.14"
  },
  "devDependencies": {
    "jsdom": "30.1.1"
  }
}
