    },
    {
      "field": "pages[4].inlineOptional.copy.paragraphs[0]",
      "text": "Think of the two dates and type what you remember, without looking back. Then compare your attempts and notice what helped.",
      "sha256": "71f2508773ba6dff443465d2738411377249d1e32290926f3cbfbd73f0098c8a",
